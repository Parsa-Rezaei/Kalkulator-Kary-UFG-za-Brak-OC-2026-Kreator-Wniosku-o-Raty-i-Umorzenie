{
  "name": "kalkulator-kary-oc",
  "version": "1.1.0",
  "private": true,
  "description": "Kalkulator kary UFG za brak OC 2025/2026 + generator wniosku PDF do UFG (raty, umorzenie, odwołanie).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/assets/styles.css --minify",
    "vendor:pdfmake": "node scripts/vendor-pdfmake.js",
    "test:verify": "node tests/verify.test.mjs",
    "test:e2e": "node tests/e2e.test.js",
    "test": "node tests/verify.test.mjs && node tests/e2e.test.js"
  },
  "devDependencies": {
    "pdfmake": "0.2.20",
    "tailwindcss": "3.4.17"
  }
}
